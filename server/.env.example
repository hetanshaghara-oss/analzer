# ─────────────────────────────────────────────────────────────────────────────
# GitInsight AI — Server environment variables
# Copy this file to `server/.env` for local development and fill in real values.
# NEVER commit `server/.env` — it is ignored by .gitignore.
# On a hosting platform (Render/Railway/Fly.io), set these in the platform's
# env-var panel instead of creating a file.
# ─────────────────────────────────────────────────────────────────────────────

# Port the API listens on. Render injects its own PORT; locally 3001.
PORT=3001

# MongoDB connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/gitinsight?retryWrites=true&w=majority

# JWT signing secrets — generate strong random values:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Where the frontend lives. Used for OAuth redirect URLs back to the browser.
# Local dev: http://localhost:5173   Production: https://your-domain.com
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Allowed browser origins for the API (comma-separated). Only needed if the
# frontend and API are deployed on different domains (split deploy). When the
# server serves the built frontend itself, leave this unset.
CORS_ORIGINS=

# ── GitHub OAuth ─────────────────────────────────────────────────────────────
# Create an OAuth app at https://github.com/settings/developers and add this
# exact redirect URI:
#   Local:      http://localhost:3001/api/auth/github/callback
#   Production: https://your-domain.com/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/github/callback

# Optional server-side GitHub token (raises the API rate limit for anonymous
# users from 60 to 5,000 req/hr). Generate a classic PAT or fine-grained token
# at https://github.com/settings/tokens
GITHUB_TOKEN=

# ── LLM (AI repo chat) ───────────────────────────────────────────────────────
# Powers the "Ask GitInsight AI" chat on the repo review page (POST /api/ai/repo-chat).
# LLM_API_KEY is REQUIRED — without it the endpoint returns 503 AI_NOT_CONFIGURED.
# IMPORTANT: all three vars must belong to the SAME provider. This example uses
# OpenRouter — key from https://openrouter.ai/keys (sk-or-...):
#   LLM_API_URL = https://openrouter.ai/api/v1/chat/completions
#   LLM_MODEL   = any model from https://openrouter.ai/models (free ones work too)
# For the Vercel AI Gateway instead, swap LLM_API_URL to
# https://ai.vercel.sh/v1/chat/completions and LLM_MODEL to a supported model
# like anthropic/claude-sonnet-4-5. Don't mix providers (that causes 404s).
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Per-user daily AI chat quota (Pro feature). A user hitting either cap gets a
# 429 for the rest of the day. Tokens are estimated as chars/4.
AI_DAILY_MESSAGE_LIMIT=30
AI_DAILY_TOKEN_LIMIT=100000

# ── Google "Sign in with Google" ─────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials → OAuth client ID (Web app)
# Redirect URI:
#   Local:      http://localhost:3001/api/auth/oauth/google/callback
#   Production: https://your-domain.com/api/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/oauth/google/callback

# ── GitLab "Sign in with GitLab" ─────────────────────────────────────────────
# https://gitlab.com/-/user_settings/applications → New application
# Scope: read_user | Redirect URI as below
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/oauth/gitlab/callback

# ── SMTP (password reset emails) ────────────────────────────────────────────
# Optional: when unset, reset links are logged/skipped instead of delivered.
# Works with any SMTP provider (Gmail app password, Resend, SendGrid, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional display sender, e.g. "GitInsight AI <no-reply@yourdomain.com>"
EMAIL_FROM=

# Node environment. Set to production on your host.
NODE_ENV=development
